# Скопіюйте у файл .env у корені проєкту (поруч із docker-compose.yml):
#   cp .env.example .env
# Заповніть значення. Docker Compose автоматично підставить їх у collector.

# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Після заповнення API_ID/HASH — згенеруйте сесію:
#   cd backend && pip install -r requirements.txt && python scripts/telegram_session.py
# Або без інтерактиву: TELEGRAM_PHONE=+380..., двічі скрипт + TELEGRAM_LOGIN_CODE (див. скрипт).
# TELEGRAM_SESSION_STRING можна записати автоматично після успішного входу.
TELEGRAM_SESSION_STRING=

# Опційно для входу без запитань у терміналі:
# TELEGRAM_PHONE=
# TELEGRAM_LOGIN_CODE=
# TELEGRAM_2FA_PASSWORD=

# Tier 2 LLM (один з ключів; LLM_PROVIDER=auto — перший доступний)
# LLM_PROVIDER=auto
# GROQ_API_KEY=          # безкоштовний tier на console.groq.com
# GROQ_MODEL=llama-3.1-8b-instant
# GOOGLE_API_KEY=        # Gemini (aistudio.google.com)
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
